<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/aivirtualclassroom/db" VERSION="20261106" COMMENT="XMLDB file for Moodle mod/aivirtualclassroom"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="aivirtualclassroom" COMMENT="AI Virtual Classroom activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Scheduled start (0 = always open)"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="60" SEQUENCE="false" COMMENT="Scheduled length in minutes"/>
        <FIELD NAME="breakoutteachers" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Comma separated teacher user ids that get a breakout room (empty = all teachers)"/>
        <FIELD NAME="videopolicy" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="teachers" SEQUENCE="false" COMMENT="all | teachers | none"/>
        <FIELD NAME="waitingroom" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="0 off, 1 guests wait, 2 everyone except teachers waits"/>
        <FIELD NAME="guestaccess" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Allow people without an account to join with the invite link"/>
        <FIELD NAME="guestkey" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false" COMMENT="Secret part of the guest invite link"/>
        <FIELD NAME="keyterms" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Course terms that improve caption recognition and translation"/>
        <FIELD NAME="emailrecordings" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="completionattendance" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Minutes attended required for completion"/>
        <FIELD NAME="completionhandraises" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Hand raises required for completion"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aivirtualclassroom_att" COMMENT="One row per connection to a meeting">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aivirtualclassroomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="eid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Event id from the edge, for idempotency"/>
        <FIELD NAME="timejoined" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeleft" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="seconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="bytesrx" TYPE="int" LENGTH="20" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Media bytes received (billable egress)"/>
        <FIELD NAME="bytestx" TYPE="int" LENGTH="20" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Media bytes sent"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aivirtualclassroomid" TYPE="foreign" FIELDS="aivirtualclassroomid" REFTABLE="aivirtualclassroom" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aivirtualclassroomid-eid" UNIQUE="true" FIELDS="aivirtualclassroomid, eid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aivirtualclassroom_hand" COMMENT="Hand raises during meetings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aivirtualclassroomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="eid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aivirtualclassroomid" TYPE="foreign" FIELDS="aivirtualclassroomid" REFTABLE="aivirtualclassroom" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aivirtualclassroomid-eid" UNIQUE="true" FIELDS="aivirtualclassroomid, eid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aivirtualclassroom_rec" COMMENT="Session recordings stored in Cloudflare R2">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aivirtualclassroomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="storagekey" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="bytes" TYPE="int" LENGTH="20" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="seconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="mimetype" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="video/webm" SEQUENCE="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="notified" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aivirtualclassroomid" TYPE="foreign" FIELDS="aivirtualclassroomid" REFTABLE="aivirtualclassroom" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aivirtualclassroomid-storagekey" UNIQUE="true" FIELDS="aivirtualclassroomid, storagekey"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aivirtualclassroom_bo" COMMENT="Student to teacher breakout room assignments">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aivirtualclassroomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aivirtualclassroomid" TYPE="foreign" FIELDS="aivirtualclassroomid" REFTABLE="aivirtualclassroom" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="teacherid" TYPE="foreign" FIELDS="teacherid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aivirtualclassroomid-userid" UNIQUE="true" FIELDS="aivirtualclassroomid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aivirtualclassroom_note" COMMENT="Private personal notes, one per user per activity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aivirtualclassroomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aivirtualclassroomid" TYPE="foreign" FIELDS="aivirtualclassroomid" REFTABLE="aivirtualclassroom" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aivirtualclassroomid-userid" UNIQUE="true" FIELDS="aivirtualclassroomid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aivirtualclassroom_snote" COMMENT="Shared notes of each room (main and breakouts) per session">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aivirtualclassroomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="session" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Session start time"/>
        <FIELD NAME="roomkey" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="roomname" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="editedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aivirtualclassroomid" TYPE="foreign" FIELDS="aivirtualclassroomid" REFTABLE="aivirtualclassroom" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aivirtualclassroomid-session-roomkey" UNIQUE="true" FIELDS="aivirtualclassroomid, session, roomkey"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
